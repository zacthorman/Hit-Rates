# Virtual environment. Never commit this: it is thousands of files, it is
# specific to your machine, and requirements.txt already describes it.
.venv/

# Cached API responses. Regenerable, and they would bloat the repo fast.
# If you ever want to share a dataset, zip the folder rather than commit it.
cache/

# Python bytecode
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Scratch output from the notebook. Delete this line if you want to keep it.
live_matches.csv

# Generated output. These are published to the gh-pages branch by
# publish.sh rather than committed here, because a 3.5 MB report rewritten
# every gameweek would put hundreds of megabytes into main's history for
# files that rebuild from the cache in seconds.
reports/
index.html

# The track record IS the point, so it is committed rather than ignored.
# !picks.json

# Scheduled-run bookkeeping. The log is machine-specific and the lock is
# transient; update.json is config you may want to keep, so it is not ignored.
update.log
.last_run.json
launchd.out.log
launchd.err.log
.update.lock

# Betfair login details and session token. NEVER commit these: the repo is
# public and update.py / publish.sh run `git add -A`.
.betfair.env
.betfair_session
*.env

# Line-up job logs
lineups_auto.log
lineups_launchd.out.log
lineups_launchd.err.log
darts_prices.json
darts_market_log.json
market_prices.json

# Every line the model prices (linelog.py), about 2 MB a busy day. Too big
# for a public repo's history; it lives on this machine with cache/.
linelog/

# Paddy Power line record (pplog.py), kept on this machine like linelog/
pplog/
.paddypower_off
.cards_off

# fmodel_live.py history cache (rebuilt from cache/ when missing)
fmodel/.history_cache*

# Bet365 via Oddschecker: off switch and the hand-run odds dumps
.bet365_off
liverpool-villarreal.txt
mancity-aek.txt
psg-barca.txt

# Claude's backups before a patch, and the bin
*.bak-*
_to_delete/

# Scratch staging for uploads and previews. Never commit: the repo is public
# and update.py / publish.sh run `git add -A`.
_stage_tmp/

# site_guard.py: the last good copy of each page, and pages it refused.
# Generated, machine-specific, and far too big for a public repo's history.
.last_good/
.rejected/
*.html.tmp
.build_status.json
*.json.tmp
